---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import Comments from "../../../../../components/Comments.astro";
import {
  formatLongDate,
  getPostPath,
  getPosts,
  type Post,
} from "../../../../../lib/posts";

export function getStaticPaths() {
  return getPosts().map((post) => {
    const [year, month, day] = post.publishedAt.split("-");
    return {
      params: { year, month, day, slug: post.slug },
    };
  });
}

const posts = getPosts();
const currentPath = Astro.url.pathname;
const index = posts.findIndex((candidate) => getPostPath(candidate) === currentPath);
const post = posts[index] as Post | undefined;

if (!post) {
  throw new Error(`글을 찾을 수 없습니다: ${currentPath}`);
}

const previous = posts[index + 1];
const next = posts[index - 1];
const Content = post.Content as any;
---

<BaseLayout
  title={post.title}
  description={post.description}
  type="article"
>
  <article class="post">
    <header class="post__header">
      <a class="back-link" href="/">← 모든 글</a>
      <h1>{post.title}</h1>
      {post.description && <p class="post__description">{post.description}</p>}
      <div class="post__meta">
        <time datetime={post.publishedAt}>{formatLongDate(post.publishedAt)}</time>
        {post.readingTime && <span>{post.readingTime}분 읽기</span>}
        {post.tags.length > 0 && <span>{post.tags.join(" · ")}</span>}
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>

    {
      (previous || next) && (
        <nav class="post-navigation" aria-label="다른 글">
          {previous && (
            <a rel="prev" href={getPostPath(previous)}>
              <span>이전 글</span>
              {previous.title}
            </a>
          )}
          {next && (
            <a rel="next" href={getPostPath(next)}>
              <span>다음 글</span>
              {next.title}
            </a>
          )}
        </nav>
      )
    }

    <Comments />
  </article>
</BaseLayout>
