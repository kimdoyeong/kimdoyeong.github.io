---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostList from "../components/PostList.astro";
import { getPosts } from "../lib/posts";
import { hobbies, milestones, projects, skills } from "../lib/profile";

const recentPosts = getPosts().slice(0, 3);
const marquee = ["SSR", "REACT", "SVELTE", "TYPESCRIPT", "SELF-HOSTED", "AI와 함께", "글쓰기"];
// Repeated so one half of the track is wider than any viewport.
const marqueeText = Array(3).fill(marquee.map((word) => `${word} ✦ `).join("")).join("");
const cardTones = ["", "card--cyan", "card--pink"];
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero__target">
      <span class="box-label">developer <span>0.99</span></span>
      <h1 id="hero-heading">
        <span>DOYEONG</span>
        <span>KIM</span>
      </h1>
      <p class="hero__name-ko" lang="ko">김도영</p>
    </div>


    <div class="hero__actions">
      <a class="chip chip--acid" href="/story/">개발 기록 읽기 →</a>
      <a class="chip chip--pink" href="https://github.com/kimdoyeong">GitHub ↗</a>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {[0, 1].map(() => <span>{marqueeText}</span>)}
    </div>
  </div>

  <section class="home-section" aria-labelledby="projects-heading">
    <header class="home-section__header">
      <p class="home-section__kicker">01 / side projects</p>
      <h2 id="projects-heading">사이드 프로젝트</h2>
    </header>

    <div class="project-grid">
      {
        projects.map((project, index) => (
          <article
            class:list={[
              "card",
              "project",
              cardTones[index % cardTones.length],
              { "project--featured": index === 0 },
            ]}
          >
            <span class="box-label">
              {project.name.toLowerCase().replaceAll(" ", "_")}{" "}
              <span>{(0.99 - index * 0.01).toFixed(2)}</span>
            </span>
            <div class="project__meta">
              <span>{project.period}</span>
              <span>{project.role}</span>
              {project.status && <strong>{project.status}</strong>}
            </div>
            <h3>{project.name}</h3>
            <p class="project__summary">{project.summary}</p>
            <ul class="project__points">
              {project.points.map((point) => <li>{point}</li>)}
            </ul>
            <ul class="stack stack--small" aria-label="기술">
              {project.stack.map((item) => <li>{item}</li>)}
            </ul>
            {project.link && (
              <a class="project__link" href={project.link.href}>
                {project.link.label} ↗
              </a>
            )}
          </article>
        ))
      }
    </div>

    <p class="home-section__more">
      <a class="chip" href="/story/">프로젝트마다 무엇을 배웠는지 →</a>
    </p>
  </section>

  <section class="home-section" aria-labelledby="path-heading">
    <header class="home-section__header">
      <p class="home-section__kicker">02 / timeline</p>
      <h2 id="path-heading">걸어온 길</h2>
    </header>

    <ol class="milestones">
      {
        milestones.map((milestone) => (
          <li>
            <span class="milestones__year">{milestone.year}</span>
            <ul>
              {milestone.items.map((item) => (
                <li>
                  <strong>{item.title}</strong>
                  {item.detail && <span>{item.detail}</span>}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </section>

  <div class="home-grid">
    <section class="card card--cyan" aria-labelledby="stack-heading">
      <span class="box-label">stack <span>0.94</span></span>
      <h2 id="stack-heading">다루는 것</h2>
      <ul class="stack">
        {skills.map((skill) => <li>{skill}</li>)}
      </ul>
    </section>

    <section class="card card--pink" aria-labelledby="hobby-heading">
      <span class="box-label">hobby <span>0.98</span></span>
      <h2 id="hobby-heading">취미 부자</h2>
      <p class="card__lede">커피, 테크, 오디오, 게임을 좋아하는 개발자입니다.</p>
      <ul class="stack">
        {hobbies.map((hobby) => <li>{hobby}</li>)}
      </ul>
    </section>

    <section class="card card--wide" aria-labelledby="writing-heading">
      <span class="box-label">writing <span>0.96</span></span>
      <h2 id="writing-heading">최근 글</h2>
      {
        recentPosts.length > 0 ? (
          <PostList posts={recentPosts} showDescription={false} />
        ) : (
          <p class="empty-index">첫 글을 준비하고 있습니다.</p>
        )
      }
      <div class="card__footer">
        <a class="chip chip--pink" href="/writing/">모든 글 →</a>
      </div>
    </section>

    <section class="card card--cyan card--wide" aria-labelledby="contact-heading">
      <span class="box-label">contact <span>0.99</span></span>
      <h2 id="contact-heading">연락</h2>
      <dl class="contact">
        <div>
          <dt>Email</dt>
          <dd><a href="mailto:hello@doyeong.dev">hello@doyeong.dev</a></dd>
        </div>
        <div>
          <dt>GitHub</dt>
          <dd><a href="https://github.com/kimdoyeong">github.com/kimdoyeong</a></dd>
        </div>
        <div>
          <dt>RSS</dt>
          <dd><a href="/feed.xml">doyeong.dev/feed.xml</a></dd>
        </div>
      </dl>
    </section>
  </div>
</BaseLayout>
