---
// 21일 글쓰기 챌린지 임시 위젯.
// 챌린지 태그가 붙은 글의 publishedAt(KST)을 기준으로 날짜별 작성 여부를 표시한다.
// 오늘/놓친 날 판정은 빌드 시점이 아니라 브라우저에서 KST 기준으로 다시 계산한다.
import { CHALLENGE_TAG, getPosts, getPostPath } from "../lib/posts";

const START_DATE = "2026-11-06"; // 1일차. 시작 글(0/21)도 1일차로 센다.
const TOTAL_DAYS = 21;

function addDays(date: string, days: number) {
  const d = new Date(`${date}T00:00:00Z`);
  d.setUTCDate(d.getUTCDate() + days);
  return d.toISOString().slice(0, 10);
}

// 시작 글(0/21)은 1일차 본편과 날짜가 같다. 본편이 먼저 잡히도록 시작 글을 맨 뒤로 보낸다.
const START_POST_SLUG = "0-challenge-start";
const challengePosts = getPosts()
  .filter((post) => post.tags.includes(CHALLENGE_TAG))
  .sort((a, b) => Number(a.slug === START_POST_SLUG) - Number(b.slug === START_POST_SLUG));

const postsByDate = new Map<string, string>();
for (const post of challengePosts) {
  if (!postsByDate.has(post.publishedAt)) {
    postsByDate.set(post.publishedAt, getPostPath(post));
  }
}

const days = Array.from({ length: TOTAL_DAYS }, (_, i) => {
  const date = addDays(START_DATE, i);
  return { day: i + 1, date, href: postsByDate.get(date) };
});
const writtenCount = days.filter((d) => d.href).length;
---

<section class="challenge" aria-labelledby="challenge-heading">
  <div class="challenge__header">
    <h2 id="challenge-heading">21일 챌린지</h2>
    <p class="challenge__stats">
      <span class="challenge__written">{writtenCount}</span>/{TOTAL_DAYS} 작성
      <span class="challenge__missed-wrap" hidden>
        {" · "}싸이버거 <span class="challenge__missed">0</span>개 적립
      </span>
    </p>
  </div>

  <ol class="challenge__grid">
    {
      days.map(({ day, date, href }) => {
        const [, m, d] = date.split("-").map(Number);
        const label = `${day}일차 ${m}월 ${d}일`;
        return (
          <li data-date={date} data-written={href ? "" : undefined}>
            {href ? (
              <a href={href} title={`${label} · 작성`}>
                <span class="challenge__day">{day}</span>
                <span class="challenge__date">{m}/{d}</span>
              </a>
            ) : (
              <span class="challenge__cell" title={label}>
                <span class="challenge__day">{day}</span>
                <span class="challenge__date">{m}/{d}</span>
              </span>
            )}
          </li>
        );
      })
    }
  </ol>

  <ul class="challenge__legend" aria-label="범례">
    <li data-state="written">작성</li>
    <li data-state="today">오늘</li>
    <li data-state="missed">놓침</li>
    <li data-state="upcoming">예정</li>
  </ul>
</section>

<script>
  function todayInKst() {
    return new Intl.DateTimeFormat("en-CA", { timeZone: "Asia/Seoul" }).format(new Date());
  }

  function render() {
    const today = todayInKst();
    let missed = 0;

    document.querySelectorAll<HTMLLIElement>(".challenge__grid li").forEach((li) => {
      const date = li.dataset.date ?? "";
      let state: string;
      if (li.hasAttribute("data-written")) state = "written";
      else if (date < today) {
        state = "missed";
        missed += 1;
      } else if (date === today) state = "today";
      else state = "upcoming";
      li.dataset.state = state;
    });

    const missedEl = document.querySelector(".challenge__missed");
    const wrap = document.querySelector<HTMLElement>(".challenge__missed-wrap");
    if (missedEl && wrap) {
      missedEl.textContent = String(missed);
      wrap.hidden = missed === 0;
    }
  }

  render();
</script>

<style>
  .challenge {
    display: grid;
    gap: var(--space-md);
    max-width: 48rem;
    margin-inline: auto;
    margin-block-start: var(--space-2xl);
    padding: var(--space-lg);
    border: var(--border) solid var(--color-pink);
    background: var(--color-card);
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--color-violet);
  }

  .challenge__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-md);
  }

  .challenge__header h2 {
    margin: 0;
    color: var(--color-acid);
    font-family: "Black Han Sans", var(--font-display);
    font-size: var(--text-lg);
    font-weight: 400;
    text-shadow: 2px 2px 0 var(--color-pink);
  }

  .challenge__stats {
    margin: 0;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  .challenge__written {
    color: var(--color-cyan);
    font-weight: 700;
  }

  .challenge__missed {
    color: var(--color-pink);
    font-weight: 700;
  }

  .challenge__grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .challenge__grid a,
  .challenge__cell {
    display: grid;
    place-items: center;
    gap: 0;
    aspect-ratio: 1;
    border: var(--border) solid var(--color-rule);
    background: var(--color-bg);
    color: var(--color-faint);
    font-family: var(--font-mono);
    text-decoration: none;
    line-height: 1.1;
    transition: transform var(--dur-short) var(--ease-out);
  }

  .challenge__day {
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .challenge__date {
    font-size: var(--text-2xs);
    opacity: 0.8;
  }

  li[data-state="written"] > * {
    border-color: var(--color-cyan);
    background: var(--color-cyan);
    color: var(--color-bg);
  }

  li[data-state="written"] a:hover {
    transform: translate(-2px, -2px);
    box-shadow: 2px 2px 0 var(--color-pink);
  }

  li[data-state="today"] > * {
    border-color: var(--color-acid);
    border-style: dashed;
    color: var(--color-acid);
  }

  li[data-state="missed"] > * {
    border-color: var(--color-pink);
    color: var(--color-pink);
    background:
      linear-gradient(
        to top right,
        transparent calc(50% - 1px),
        rgb(255 43 214 / 0.45) calc(50% - 1px),
        rgb(255 43 214 / 0.45) calc(50% + 1px),
        transparent calc(50% + 1px)
      ),
      var(--color-bg);
  }

  .challenge__legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--color-faint);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
  }

  .challenge__legend li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .challenge__legend li::before {
    content: "";
    width: 0.75rem;
    height: 0.75rem;
    border: var(--border) solid var(--color-rule);
  }

  .challenge__legend [data-state="written"]::before {
    border-color: var(--color-cyan);
    background: var(--color-cyan);
  }

  .challenge__legend [data-state="today"]::before {
    border-color: var(--color-acid);
    border-style: dashed;
  }

  .challenge__legend [data-state="missed"]::before {
    border-color: var(--color-pink);
  }

  @media (max-width: 30rem) {
    .challenge {
      padding: var(--space-md);
    }

    .challenge__date {
      display: none;
    }
  }
</style>
