---
import {
  ASK_ENABLED,
  ASK_ENDPOINT,
  ASK_MAX_QUESTION_LENGTH,
  ASK_SUGGESTIONS,
  TURNSTILE_SITE_KEY,
} from "../lib/ask";
---

{
  ASK_ENABLED && (
    <aside
      class="ask-dock"
      id="ask-dock"
      aria-label="AI에게 질문하기"
      data-endpoint={ASK_ENDPOINT}
      data-sitekey={TURNSTILE_SITE_KEY}
      hidden
    >
      <div class="ask-dock__panel" id="ask-panel" hidden>
        <div class="ask-dock__head">
          <span class="box-label">
            ask_ai <span>beta</span>
          </span>
          <button type="button" class="ask-dock__tool" data-ask-reset>
            새 대화
          </button>
          <button type="button" class="ask-dock__tool" data-ask-close>
            닫기
          </button>
        </div>
        <div class="ask-dock__log" id="ask-log" role="log" aria-live="polite" tabindex="0" />
        <ul class="ask-dock__suggestions" id="ask-suggestions">
          {ASK_SUGGESTIONS.map((question) => (
            <li>
              <button type="button" data-ask-question={question}>
                {question}
              </button>
            </li>
          ))}
        </ul>
        <div class="ask-dock__turnstile" id="ask-turnstile" />
        <form class="ask-dock__bar" id="ask-form" data-ask-form>
          <label class="ask-dock__label" for="ask-input">
            AI에게 질문
          </label>
          <input
            id="ask-input"
            name="question"
            type="text"
            autocomplete="off"
            enterkeyhint="send"
            maxlength={ASK_MAX_QUESTION_LENGTH}
            placeholder="김도영에 대해 물어보세요"
          />
          <button type="submit">질문</button>
        </form>
        <p class="ask-dock__note">
          AI가 이 사이트의 글을 바탕으로 답합니다. 틀릴 수 있으니 중요한 내용은 원문을 확인해 주세요.
        </p>
      </div>

      <button
        type="button"
        class="ask-dock__fab"
        id="ask-fab"
        aria-label="AI에게 질문하기"
        aria-controls="ask-panel"
        aria-expanded="false"
      >
        <span aria-hidden="true">AI</span>
      </button>
    </aside>
  )
}

<script>
  interface Message {
    role: "user" | "assistant";
    content: string;
  }

  interface TurnstileApi {
    render(container: HTMLElement, options: Record<string, unknown>): string;
    remove(widgetId: string): void;
  }

  const STORAGE_KEY = "ask:v1";
  // Worker가 받는 대화 길이 한도 (worker/src/index.ts의 MAX_MESSAGES)와 맞춘다.
  const MAX_SENT_MESSAGES = 11;

  const ERROR_TEXT: Record<string, string> = {
    rate: "질문이 너무 빠릅니다. 잠시 뒤에 다시 시도해 주세요.",
    ip_daily: "오늘 질문할 수 있는 횟수를 모두 썼습니다. 내일 다시 찾아 주세요.",
    global_daily: "오늘 준비된 AI 답변이 모두 소진됐습니다. 내일 다시 찾아 주세요.",
    invalid: "질문을 처리할 수 없습니다. 조금 짧게 다시 써 주세요.",
    turnstile: "사람인지 확인하지 못했습니다. 다시 시도해 주세요.",
    unavailable: "지금은 AI가 답할 수 없습니다. 잠시 뒤에 다시 시도해 주세요.",
  };

  const dock = document.querySelector<HTMLElement>("#ask-dock");
  if (dock) setup(dock);

  function setup(dock: HTMLElement) {
    const endpoint = dock.dataset.endpoint!;
    const sitekey = dock.dataset.sitekey!;
    const panel = dock.querySelector<HTMLElement>("#ask-panel")!;
    const log = dock.querySelector<HTMLElement>("#ask-log")!;
    const suggestions = dock.querySelector<HTMLElement>("#ask-suggestions")!;
    const turnstileBox = dock.querySelector<HTMLElement>("#ask-turnstile")!;
    const input = dock.querySelector<HTMLInputElement>("#ask-input")!;
    const fab = dock.querySelector<HTMLButtonElement>("#ask-fab")!;

    let messages: Message[] = [];
    let session = "";
    let busy = false;
    let turnstileLoading: Promise<TurnstileApi> | undefined;
    let widgetId: string | undefined;

    try {
      const saved = JSON.parse(sessionStorage.getItem(STORAGE_KEY) ?? "{}");
      if (Array.isArray(saved.messages)) messages = saved.messages;
      if (typeof saved.session === "string") session = saved.session;
    } catch {
      // 저장소를 쓸 수 없으면 대화를 이어 가지 않을 뿐이다.
    }

    function save() {
      try {
        sessionStorage.setItem(STORAGE_KEY, JSON.stringify({ messages, session }));
      } catch {
        // 위와 같다.
      }
    }

    function escapeHtml(text: string) {
      return text
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;");
    }

    /** 답변에 쓰이는 최소한의 마크다운(링크, 굵게, 코드, 문단)만 그린다. */
    function renderMarkdown(text: string) {
      return escapeHtml(text.trim())
        .replace(
          /\[([^\]]+)\]\((\/[^\s)]*|https:\/\/[^\s)]+)\)/g,
          (_match, label: string, href: string) => `<a href="${href}">${label}</a>`,
        )
        .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
        .replace(/`([^`]+)`/g, "<code>$1</code>")
        .split(/\n{2,}/)
        .map((paragraph) => `<p>${paragraph.replaceAll("\n", "<br />")}</p>`)
        .join("");
    }

    function addBubble(role: Message["role"] | "error", text: string) {
      const bubble = document.createElement("div");
      bubble.className = `ask-msg ask-msg--${role}`;
      setBubble(bubble, role, text);
      log.append(bubble);
      log.scrollTop = log.scrollHeight;
      return bubble;
    }

    function setBubble(bubble: HTMLElement, role: Message["role"] | "error", text: string) {
      if (role === "assistant") {
        bubble.innerHTML = renderMarkdown(text);
      } else {
        bubble.textContent = text;
      }
    }

    function renderAll() {
      log.replaceChildren();
      for (const message of messages) addBubble(message.role, message.content);
      suggestions.hidden = messages.length > 0;
    }

    function open() {
      panel.hidden = false;
      dock.classList.add("ask-dock--open");
      fab.setAttribute("aria-expanded", "true");
      log.scrollTop = log.scrollHeight;
    }

    function close() {
      panel.hidden = true;
      dock.classList.remove("ask-dock--open");
      fab.setAttribute("aria-expanded", "false");
    }

    function loadTurnstile() {
      turnstileLoading ??= new Promise<TurnstileApi>((resolve, reject) => {
        const script = document.createElement("script");
        script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
        script.async = true;
        script.onload = () => resolve((window as unknown as { turnstile: TurnstileApi }).turnstile);
        script.onerror = () => {
          turnstileLoading = undefined;
          reject(new Error("turnstile"));
        };
        document.head.append(script);
      });
      return turnstileLoading;
    }

    async function getTurnstileToken() {
      const turnstile = await loadTurnstile();
      if (widgetId !== undefined) turnstile.remove(widgetId);
      return new Promise<string>((resolve, reject) => {
        widgetId = turnstile.render(turnstileBox, {
          sitekey,
          theme: "dark",
          appearance: "interaction-only",
          callback: resolve,
          "error-callback": () => reject(new Error("turnstile")),
        });
      });
    }

    function post(history: Message[], turnstileToken?: string) {
      return fetch(`${endpoint}/ask`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ messages: history, session, turnstileToken }),
      });
    }

    async function request(history: Message[]) {
      let response = session ? await post(history) : undefined;
      // 세션이 없거나 만료됐으면 Turnstile 확인을 거쳐 새로 받는다.
      if (!response || response.status === 401) {
        response = await post(history, await getTurnstileToken());
      }
      const issued = response.headers.get("X-Ask-Session");
      if (issued) session = issued;
      return response;
    }

    async function ask(question: string) {
      const text = question.trim();
      if (!text || busy) return;

      busy = true;
      dock.classList.add("ask-dock--busy");
      open();
      suggestions.hidden = true;
      log.querySelectorAll(".ask-msg--error").forEach((node) => node.remove());
      const userBubble = addBubble("user", text);

      const history = [...messages, { role: "user" as const, content: text }];
      // 한도를 넘으면 오래된 질문-답변 쌍부터 버린다.
      const sent = history.slice(-MAX_SENT_MESSAGES);
      const bubble = addBubble("assistant", "");
      bubble.classList.add("ask-msg--pending");

      try {
        const response = await request(sent);

        if (!response.ok || !response.body) {
          const body = await response.json().catch(() => ({}));
          throw new Error(typeof body.error === "string" ? body.error : "unavailable");
        }

        const reader = response.body.getReader();
        const decoder = new TextDecoder();
        let answer = "";
        for (;;) {
          const { done, value } = await reader.read();
          if (done) break;
          answer += decoder.decode(value, { stream: true });
          bubble.classList.remove("ask-msg--pending");
          setBubble(bubble, "assistant", answer);
          log.scrollTop = log.scrollHeight;
        }
        if (!answer.trim()) throw new Error("unavailable");

        messages = [...history, { role: "assistant", content: answer }];
      } catch (error) {
        bubble.remove();
        const code = error instanceof Error ? error.message : "";
        addBubble("error", ERROR_TEXT[code] ?? ERROR_TEXT.unavailable);
        // 실패한 질문은 대화에 남기지 않고 입력창으로 되돌린다.
        userBubble.remove();
        input.value = text;
      } finally {
        busy = false;
        dock.classList.remove("ask-dock--busy");
        suggestions.hidden = messages.length > 0;
        save();
      }
    }

    document.addEventListener("submit", (event) => {
      const form = (event.target as HTMLElement).closest<HTMLFormElement>("[data-ask-form]");
      if (!form) return;
      event.preventDefault();
      const field = form.elements.namedItem("question") as HTMLInputElement;
      const question = field.value;
      field.value = "";
      void ask(question);
    });

    document.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      const suggestion = target.closest<HTMLElement>("[data-ask-question]");
      if (suggestion) {
        void ask(suggestion.dataset.askQuestion ?? "");
      } else if (target.closest("[data-ask-close]")) {
        close();
        fab.focus();
      } else if (target.closest("#ask-fab")) {
        if (panel.hidden) {
          open();
          input.focus();
        } else {
          close();
        }
      } else if (target.closest("[data-ask-reset]") && !busy) {
        messages = [];
        save();
        renderAll();
        input.focus();
      }
    });

    dock.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !panel.hidden) {
        close();
        fab.focus();
      }
    });

    renderAll();
    dock.hidden = false;
    for (const element of document.querySelectorAll<HTMLElement>("[data-ask-reveal]")) {
      element.hidden = false;
    }
  }
</script>
