---
const currentPath = Astro.url.pathname;

const links = [
  { href: "/", label: "소개", match: (path: string) => path === "/" },
  { href: "/story/", label: "기록", match: (path: string) => path.startsWith("/story/") },
  {
    href: "/writing/",
    label: "글",
    match: (path: string) => path.startsWith("/writing/") || path.startsWith("/tags/"),
  },
];
---

<header class="masthead">
  <a class="masthead__wordmark" href="/" aria-label="doyeong.dev 홈">
    <span>DOYEONG</span><span>.</span><span>DEV</span>
  </a>

  <nav class="masthead__nav" aria-label="주요 메뉴">
    {
      links.map(({ href, label, match }) => (
        <a
          class="chip"
          href={href}
          aria-current={match(currentPath) ? "page" : undefined}
        >
          {label}
        </a>
      ))
    }
  </nav>
</header>
