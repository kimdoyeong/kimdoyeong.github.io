{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doyeong-ask",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "ask.doyeong.dev", "custom_domain": true }],
  "observability": { "enabled": true },
  "vars": {
    "ALLOWED_ORIGINS": "https://doyeong.dev",
    // API를 실제로 호출하는 질문 수의 하루 상한 (KST 자정에 초기화).
    "DAILY_LIMIT": "300",
    "IP_DAILY_LIMIT": "30"
  },
  // 비밀 값은 `wrangler secret put`으로 넣는다: ANTHROPIC_API_KEY, TURNSTILE_SECRET, CONTEXT_TOKEN
  "durable_objects": {
    "bindings": [{ "name": "BUDGET", "class_name": "Budget" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Budget"] }],
  // 질문 기록 (통계용). 스키마는 migrations/ 에 있다.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "doyeong-ask",
      "database_id": "6b44567a-0314-444b-9fde-de2feaa03be7"
    }
  ],
  "ratelimits": [
    // IP당 분당 5회.
    { "name": "BURST", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ]
}
